# Database (local Postgres; on Neon use its connection string)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dispatch_agent

# Public URL of this app (used in links sent to customers)
APP_URL=http://localhost:3000

# Google Gemini (aistudio.google.com -> Get API key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_LIVE_MODEL=

# Telegram bot (@BotFather -> /newbot)
TELEGRAM_BOT_TOKEN=
# Your own Telegram chat id for owner alerts (filled in automatically after you message the bot /owner)
TELEGRAM_OWNER_CHAT_ID=

# OpenRouteService (openrouteservice.org -> Dashboard -> API key)
ORS_API_KEY=

# Stripe TEST mode secret key (starts with sk_test_)
STRIPE_SECRET_KEY=

# Secret for scheduled-job endpoints (/api/cron/*)
CRON_SECRET=change-me

# Google OAuth for Gmail + Calendar (later)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
